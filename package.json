{
  "name": "cng-route-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n app,mimit \"vite --host 0.0.0.0\" \"CNG_PROXY_ONLY=1 node --experimental-strip-types server/proxy.ts\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node --experimental-strip-types server/proxy.ts",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@turf/helpers": "latest",
    "@turf/nearest-point-on-line": "latest",
    "@turf/simplify": "latest",
    "dexie": "latest",
    "leaflet": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/geojson": "latest",
    "@types/leaflet": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "fake-indexeddb": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest",
    "vitest": "latest"
  }
}
